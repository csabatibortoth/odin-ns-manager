{
  "name": "athena-ui-js",
  "version": "0.4.1",
  "description": "A small jQuery based UI framework: generated page layout, menus, login form, modals and themes, written as ES modules.",
  "type": "module",
  "main": "./src/athena-ui.js",
  "exports": {
    ".": "./src/athena-ui.js",
    "./themes/*": "./src/res/themes/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/athena-ui.js",
    "src/libs/libs.js",
    "src/libs/config",
    "src/libs/hephaestus/hephaestus.js",
    "src/libs/hephaestus/LayoutGenerator",
    "src/libs/hephaestus/MenuGenerator",
    "src/libs/hephaestus/formGenerator",
    "src/libs/hephaestus/modalGenerator",
    "src/libs/hephaestus/HTMLControlGenerator/LICENSE",
    "src/libs/hephaestus/HTMLControlGenerator/src/HTMLControlGenerator.min.js",
    "src/libs/hephaestus/HTMLElementGenerator/LICENSE",
    "src/libs/hephaestus/HTMLElementGenerator/src/HTMLElementGenerator.js",
    "src/libs/hephaestus/HTMLElementGenerator/src/errors.js",
    "src/libs/crypto-js/LICENSE",
    "src/libs/crypto-js/crypto-js.js",
    "src/libs/js-cookie/LICENSE",
    "src/libs/js-cookie/src",
    "src/res"
  ],
  "sideEffects": true,
  "keywords": [
    "ui",
    "framework",
    "jquery",
    "layout",
    "menu",
    "login-form",
    "modal",
    "themes",
    "es-modules"
  ],
  "peerDependencies": {
    "jquery": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csabatibortoth/athena-ui.git"
  },
  "homepage": "https://github.com/csabatibortoth/athena-ui#readme",
  "bugs": {
    "url": "https://github.com/csabatibortoth/athena-ui/issues"
  },
  "author": "Csaba Tóth (https://github.com/csabatibortoth)",
  "license": "MIT"
}
