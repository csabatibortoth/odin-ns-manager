{
  "name": "athena-ui-js",
  "version": "2.4.1",
  "description": "A small, dependency-free UI framework: forms, tables, charts, menus, dialogs, themes and a router, written as ES modules.",
  "type": "module",
  "main": "./src/athena-ui.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser/run.mjs",
    "docs": "node scripts/styling-docs.mjs",
    "check:package": "node scripts/check-package.mjs",
    "types": "tsc -p tsconfig.types.json",
    "test:demo": "node --test --test-timeout=600000 demo/tests/demo.test.mjs demo/tests/browser.test.mjs",
    "demo": "node demo/server.mjs",
    "demo:build": "node demo/scripts/build-package.mjs"
  },
  "exports": {
    ".": {
      "types": "./types/athena-ui.d.ts",
      "default": "./src/athena-ui.js"
    },
    "./classic": {
      "types": "./types/classic.d.ts",
      "default": "./src/classic.js"
    },
    "./testing": {
      "types": "./types/testing.d.ts",
      "default": "./src/testing.js"
    },
    "./theme-boot.js": "./src/theme-boot.js",
    "./table": {
      "types": "./types/table.d.ts",
      "default": "./src/table.js"
    },
    "./chart": {
      "types": "./types/chart.d.ts",
      "default": "./src/chart.js"
    },
    "./dialog": {
      "types": "./types/dialog.d.ts",
      "default": "./src/dialog.js"
    },
    "./menu": {
      "types": "./types/menu.d.ts",
      "default": "./src/menu.js"
    },
    "./navigation": {
      "types": "./types/navigation.d.ts",
      "default": "./src/navigation.js"
    },
    "./forms": {
      "types": "./types/forms.d.ts",
      "default": "./src/forms.js"
    },
    "./feedback": {
      "types": "./types/feedback.d.ts",
      "default": "./src/feedback.js"
    },
    "./components": {
      "types": "./types/components.d.ts",
      "default": "./src/components.js"
    },
    "./inputs": {
      "types": "./types/inputs.d.ts",
      "default": "./src/inputs.js"
    },
    "./router": {
      "types": "./types/router.d.ts",
      "default": "./src/router.js"
    },
    "./session": {
      "types": "./types/session.d.ts",
      "default": "./src/session.js"
    },
    "./theme": {
      "types": "./types/theme.d.ts",
      "default": "./src/theme.js"
    },
    "./i18n": {
      "types": "./types/i18n.d.ts",
      "default": "./src/i18n.js"
    },
    "./format": {
      "types": "./types/format.d.ts",
      "default": "./src/format.js"
    },
    "./validation": {
      "types": "./types/validation.d.ts",
      "default": "./src/validation.js"
    },
    "./motion": {
      "types": "./types/motion.d.ts",
      "default": "./src/motion.js"
    },
    "./widgets": {
      "types": "./types/widgets.d.ts",
      "default": "./src/widgets.js"
    },
    "./code": {
      "types": "./types/code.d.ts",
      "default": "./src/code.js"
    },
    "./sanitize": {
      "types": "./types/sanitize.d.ts",
      "default": "./src/sanitize.js"
    },
    "./csv": {
      "types": "./types/csv.d.ts",
      "default": "./src/csv.js"
    },
    "./dom": {
      "types": "./types/dom.d.ts",
      "default": "./src/dom.js"
    },
    "./controls": {
      "types": "./types/controls.d.ts",
      "default": "./src/controls.js"
    },
    "./themes/*": "./src/res/themes/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/libs/config",
    "src/libs/hephaestus/hephaestus.js",
    "src/libs/hephaestus/LayoutGenerator",
    "src/libs/hephaestus/MenuGenerator",
    "src/libs/hephaestus/formGenerator",
    "src/libs/core",
    "src/libs/hephaestus/auth",
    "src/libs/hephaestus/router",
    "src/libs/hephaestus/feedbackGenerator",
    "src/libs/hephaestus/dialogGenerator",
    "src/libs/hephaestus/navigationGenerator",
    "src/libs/hephaestus/componentGenerator",
    "src/libs/hephaestus/inputGenerator",
    "src/libs/hephaestus/chartGenerator",
    "src/libs/hephaestus/tableGenerator",
    "src/libs/hephaestus/modalGenerator",
    "src/libs/hephaestus/widgetGrid",
    "src/libs/hephaestus/codeGenerator",
    "src/res",
    "src/*.js",
    "!src/example.js",
    "types",
    "docs"
  ],
  "sideEffects": [
    "./src/classic.js",
    "./src/theme-boot.js",
    "*.css"
  ],
  "keywords": [
    "ui",
    "framework",
    "layout",
    "menu",
    "login-form",
    "registration-form",
    "chart",
    "table",
    "form-builder",
    "dialog",
    "router",
    "dark-theme",
    "i18n",
    "rich-text",
    "virtual-scroll",
    "modal",
    "themes",
    "es-modules"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csabatibortoth/athena-ui.git"
  },
  "homepage": "https://github.com/csabatibortoth/athena-ui#readme",
  "bugs": {
    "url": "https://github.com/csabatibortoth/athena-ui/issues"
  },
  "author": "Csaba Tóth (https://github.com/csabatibortoth)",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "types": "./types/athena-ui.d.ts"
}
