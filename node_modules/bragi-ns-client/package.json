{
  "name": "bragi-ns-client",
  "version": "2.1.0",
  "description": "An implementation to speed up the nodejs `dns.lookup` method by avoiding thread pool and using resolve4/resolve6 with DNS TTL values",
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "npm run unit-test && npm run func-test",
    "tests": "npm test",
    "unit-test": "mocha tests/Unit",
    "func-test": "mocha --timeout 15000 tests/Functional",
    "test:coverage": "c8 --reporter=text --reporter=lcov mocha --timeout 15000 tests"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/csabatibortoth/bragi-ns-client.git"
  },
  "keywords": [
    "dns",
    "dnssec",
    "lookup",
    "resolve4",
    "resolve6",
    "cache",
    "ipv4",
    "ipv6"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "mocha": "^12.0.3",
    "sinon": "^22.1.0"
  },
  "bugs": {
    "url": "https://github.com/csabatibortoth/bragi-ns-client/issues"
  },
  "homepage": "https://github.com/csabatibortoth/bragi-ns-client"
}
